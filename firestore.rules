rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Daily aggregated analytics - Public read for the private /view dashboard
    match /analytics_daily/{date} {
      allow read: if true;
      
      // Allow recording views
      allow create, update: if true;
    }

    // Deduplication records for anonymous devices
    match /analytics_devices/{deviceId} {
      allow read: if true;
      allow create, update: if true;
    }

    // Default deny for all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
